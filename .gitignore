# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/.auth
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# v0.dev scratch downloads
/temp

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Sentry Config File
.env.sentry-build-plugin

# Capacitor Android — build-artefacten en machine-specifieke bestanden
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/*.keystore
/android/**/google-services.json
# Build-tijd-kopie van public/, ongebruikt bij remote laden (server.url in capacitor.config.ts),
# puur een duplicaat van bestanden die al elders in de repo staan (was 40MB).
/android/app/src/main/assets/public/
# Android Studio-projectinstellingen: lokale IDE-configuratie, geen projectcode.
/android/.idea/
